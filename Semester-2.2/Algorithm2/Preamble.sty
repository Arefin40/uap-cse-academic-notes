% #ANCHOR Font settings
\RequirePackage{fontspec}
\RequirePackage[T1]{fontenc}
\RequirePackage[skip=10pt, indent=0pt]{parskip}
\setmainfont{Merriweather Light}
\setmonofont{IBM Plex Mono}
\newfontfamily\banglafont[Script=Bengali]{Tiro Bangla}
\newcommand{\bn}[1]{{\banglafont #1}}
\renewcommand{\normalsize}{\fontsize{10pt}{20pt}\selectfont}

% #ANCHOR Number Font
\newfontfamily\fdigitsu{Lora}
\XeTeXinterchartokenstate = 1
\newXeTeXintercharclass \digits
\XeTeXcharclass `\0 \digits
\XeTeXcharclass `\1 \digits
\XeTeXcharclass `\2 \digits
\XeTeXcharclass `\3 \digits
\XeTeXcharclass `\4 \digits
\XeTeXcharclass `\5 \digits
\XeTeXcharclass `\6 \digits
\XeTeXcharclass `\7 \digits
\XeTeXcharclass `\8 \digits
\XeTeXcharclass `\9 \digits
\XeTeXinterchartoks 4095 \digits = {\bgroup\fdigitsu}
\XeTeXinterchartoks \digits 4095 = {\egroup}
\XeTeXinterchartoks 0 \digits = {\bgroup\fdigitsu}
\XeTeXinterchartoks \digits 0 = {\egroup}


% #ANCHOR Link settings
\RequirePackage{hyperref}
\hypersetup{
    colorlinks,
    citecolor=black,
    filecolor=black,
    linkcolor=black,
    urlcolor=black
}


% #ANCHOR List settings
\RequirePackage{enumerate,enumitem}
\setlist[enumerate]{noitemsep}


% #ANCHOR Equation (Math Mode)
\everymath{\displaystyle}
